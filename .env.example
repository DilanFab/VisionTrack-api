# Puerto de la API
PORT=3000

# Cadena de conexión para Supabase (Modo Directo o Pooler)
# Reemplaza [TU_CONTRASEÑA] e [ID_PROYECTO] con tus credenciales de Supabase
DATABASE_URL="postgresql://postgres:[TU_CONTRASEÑA]@db.[ID_PROYECTO].supabase.co:5432/postgres"

# JWT
JWT_SECRET="visiontrack-super-secret-key-change-in-production"

# Auth bypass: true desactiva verifyToken + authorize para desarrollo
AUTH_BYPASS=true
