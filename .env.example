# Puerto de la API
PORT=3000

# Cadena de conexión para Supabase (Modo Directo o Pooler)
# Reemplaza [TU_CONTRASEÑA] e [ID_PROYECTO] con tus credenciales de Supabase
DATABASE_URL="postgresql://postgres:[TU_CONTRASEÑA]@db.[ID_PROYECTO].supabase.co:5432/postgres"

# JWT
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Auth bypass: true desactiva verifyToken + authorize para desarrollo
AUTH_BYPASS=true

# CORS — orígenes permitidos (separados por coma)
CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# Entorno
NODE_ENV=development

# Notificaciones — Resend (emails)
# Obtén tu API key en https://resend.com
RESEND_API_KEY=

# Notificaciones — Expo Push
EXPO_PUSH_ENABLED=true
